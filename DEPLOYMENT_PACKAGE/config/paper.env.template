# Phantom deployment profile: PAPER
#
# Copy to a real `.env` (or set as real Windows environment variables) —
# never commit a filled-in copy of this file.
#
# PAPER requires MT5_LOGIN/MT5_PASSWORD/MT5_SERVER to be present and the
# MT5 login to point at a genuine **demo** account —
# `PaperTradingRunner.connect()` calls an injected `confirm_demo_account`
# probe before every cycle and refuses to run at all if it does not
# confirm a demo account (`paper_trading_runner.py`'s own hard rule).
# Pointing this profile at a real funded account does not "go live" —
# it simply fails the demo-account guard on the first cycle.

PHANTOM_PROFILE=PAPER

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

PHANTOM_SYMBOLS=EURUSD

PHANTOM_SPREAD_THRESHOLD=0.0005
PHANTOM_SLIPPAGE_THRESHOLD=0.0005
PHANTOM_MAX_SPREAD=0.0005

# Must stay true for this profile's own demo-account guard to be the
# intended safety net; ConfigurationManager does not itself require this
# for PAPER (only LIVE is checked), but start_phantom.py's PAPER branch
# always runs through PaperTradingRunner regardless of this flag's value.
PAPER_TRADING_ENABLED=true

BROKER_PROFILE=
ALLOWED_BROKER_PROFILES=

PROMETHEUS_BASE_URL=

PHANTOM_LOG_DIR=C:\phantom\logs
PHANTOM_LOG_ARCHIVE_DIR=C:\phantom\logs\archive
PHANTOM_CRASH_DUMP_DIR=C:\phantom\crash_dumps
PHANTOM_BACKUP_DIR=C:\phantom\backups

# Daily reset hour (UTC) SessionManager/AccountTracker use for
# trading-day boundaries. 0-23.
PHANTOM_DAILY_RESET_HOUR_UTC=0
