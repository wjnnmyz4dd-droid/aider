# Phantom deployment profile: LIVE
#
# Copy to a real `.env` (or set as real Windows environment variables) —
# never commit a filled-in copy of this file, and never reuse a
# DEV/PAPER MT5 login here.
#
# `ConfigurationManager.validate` treats every one of the following as a
# hard startup blocker for this profile: missing MT5_LOGIN/MT5_PASSWORD/
# MT5_SERVER, a non-numeric MT5_LOGIN, PAPER_TRADING_ENABLED=true, or a
# BROKER_PROFILE not present in ALLOWED_BROKER_PROFILES (when that list is
# set). See `LIVE_DEPLOYMENT_GUIDE.md` before filling this in.

PHANTOM_PROFILE=LIVE

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

PHANTOM_SYMBOLS=EURUSD

PHANTOM_SPREAD_THRESHOLD=0.0005
PHANTOM_SLIPPAGE_THRESHOLD=0.0005
PHANTOM_MAX_SPREAD=0.0005

# Must be false. ConfigurationManager.validate rejects LIVE + true.
PAPER_TRADING_ENABLED=false

# Recommended for LIVE: set both, so a config accidentally pointed at
# the wrong broker fails validation instead of silently connecting.
BROKER_PROFILE=
ALLOWED_BROKER_PROFILES=

PROMETHEUS_BASE_URL=

PHANTOM_LOG_DIR=C:\phantom\logs
PHANTOM_LOG_ARCHIVE_DIR=C:\phantom\logs\archive
PHANTOM_CRASH_DUMP_DIR=C:\phantom\crash_dumps
PHANTOM_BACKUP_DIR=C:\phantom\backups

# Windows service unit names used by RealRecoveryActionExecutor for
# RESTART_SERVICE/RESTART_WORKER/RESTART_MONITORING actions, if wired to
# a real Windows Service (see VPS_SETUP_GUIDE.md §3). Leave blank if you
# have not yet registered these as Windows Services.
PHANTOM_MT5_SERVICE_UNIT=
PHANTOM_CORE_SERVICE_UNIT=

# NOTE: start_phantom.py's LIVE branch performs configuration validation,
# service startup, and the full DeploymentValidator go-live check set —
# it does not run a continuous live-order-submission loop. No such
# scheduler exists yet anywhere in phantom_pipeline (only a single-shot
# `run_scan_cycle` call); see START_PHANTOM.md and
# LIVE_DEPLOYMENT_GUIDE.md for the current, honest state of this gap.
