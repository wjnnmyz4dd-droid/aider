# Phantom deployment profile: DEV
#
# Copy to a real `.env` (or set as real Windows environment variables) —
# never commit a filled-in copy of this file. `ConfigurationManager`
# reads these as a plain mapping; it never touches `os.environ` itself,
# so this file's real consumer is `start_phantom.py`'s own bootstrap
# code, which does the one, sanctioned `os.environ` read.
#
# DEV requires none of these to be present (ConfigurationManager.validate
# only enforces secrets/account checks for PAPER/LIVE) — set only what
# you need for a local smoke run.

PHANTOM_PROFILE=DEV

# Optional in DEV. If set, MT5Adapter/MarketDataAdapter will attempt a
# real MT5 terminal connection; if unset, start_phantom.py runs a
# construction-only smoke test with no live connection.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Comma-separated list of symbols this deployment scans/trades.
PHANTOM_SYMBOLS=EURUSD

# Uniform per-symbol thresholds (see LIVE_DEPLOYMENT_GUIDE.md for what
# each engine does with these) — DEV defaults are deliberately loose.
PHANTOM_SPREAD_THRESHOLD=0.0010
PHANTOM_SLIPPAGE_THRESHOLD=0.0010
PHANTOM_MAX_SPREAD=0.0010

# Never enabled in DEV/LIVE — this is PAPER-profile-only, checked here
# only so the same loader code path is exercised identically everywhere.
PAPER_TRADING_ENABLED=false

# Broker profile identity (advisory in DEV; enforced in LIVE if
# ALLOWED_BROKER_PROFILES is set).
BROKER_PROFILE=
ALLOWED_BROKER_PROFILES=

# Optional: a live Prometheus server's HTTP query API base URL
# (dashboard.prometheus_adapter.PrometheusAdapter). Leave unset to use
# the in-memory FakePrometheusReadPort instead.
PROMETHEUS_BASE_URL=

# Local directories for logs/backups/crash dumps (created if missing).
PHANTOM_LOG_DIR=./phantom_runtime/logs
PHANTOM_LOG_ARCHIVE_DIR=./phantom_runtime/logs/archive
PHANTOM_CRASH_DUMP_DIR=./phantom_runtime/crash_dumps
PHANTOM_BACKUP_DIR=./phantom_runtime/backups
