; PhantomBridgeEA.set
; Default input parameter template for mt5/PhantomBridgeEA.mq5 (ADR-023).
;
; This is a transport-bridge EA only -- it never generates, scores, or
; sizes trades. Every value below configures the terminal-side relay to
; the Phantom Python backend; trading decisions remain entirely in
; Data Pipeline -> Scanner -> Strategy Engine -> Scoring -> Risk ->
; Compliance -> Execution Validator -> MT5 Bridge -> Position Manager.
;
; Load via MetaTrader 5: Strategy Tester / chart EA properties ->
; "Load" -> select this file. Replace ApiKey before attaching to a
; live or demo account -- an empty key will fail every request once
; the backend enforces authentication.

BackendUrl=http://127.0.0.1:8787
ApiKey=
HeartbeatIntervalSeconds=5
BarSyncIntervalSeconds=60
AllowedSymbolsCsv=
MagicNumber=20260708
MaxSlippagePoints=20
FailClosedTimeoutSeconds=30
EmergencyDisable=false
BarTimeframesCsv=M15,H1,H4,D1
