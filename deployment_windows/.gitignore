# Real, secret-bearing configuration -- never commit this. Only
# config/titan_protocol_config.example.json (no real secrets) is tracked.
titan_protocol_config.json

# install.py's auto-generated Bridge API key (a locally-generated
# shared secret, never a real config value checked into the repo).
.bridge_api_key.secret

# install.py's installation report (machine/run-specific).
INSTALLATION_REPORT.md

# Local virtual environment, logs, and runtime state -- machine-local,
# never part of the deployment package's source of truth.
.venv/
logs/
state/
__pycache__/
*.pyc
